{
  "name": "ingle-plugin-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown skills loaded on demand.",
  "type": "module",
  "ingle": {
    "plugins": {
      "skills": {
        "module": "./index.ts",
        "title": "Skills",
        "description": "Markdown skills loaded on demand.",
        "permissions": [
          "storage"
        ],
        "contributes": {
          "ops": [
            "skill.delete",
            "skill.list",
            "skill.put",
            "skill.read"
          ]
        }
      },
      "tool-skills": {
        "module": "./tools.ts",
        "title": "Skills tools",
        "description": "The model-facing skills tools. Disable to hide them; the skills service keeps running.",
        "permissions": [
          "plugins"
        ],
        "contributes": {
          "tools": [
            "skill"
          ]
        }
      }
    },
    "bundle": [
      {
        "id": "skills",
        "plugin": "skills"
      },
      {
        "id": "tool-skills",
        "plugin": "tool-skills"
      }
    ]
  }
}
