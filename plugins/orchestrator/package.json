{
  "name": "ingle-plugin-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Coordinator tools and threads.",
  "type": "module",
  "ingle": {
    "plugins": {
      "orchestrator": {
        "module": "./index.ts",
        "title": "Orchestrator",
        "description": "Coordinator tools and threads.",
        "permissions": [
          "conversations",
          "files",
          "models"
        ],
        "contributes": {
          "ops": [
            "captain.*",
            "thread.archive",
            "thread.create",
            "thread.send",
            "thread.side",
            "thread.stop"
          ]
        },
        "requires": [
          "presets"
        ]
      },
      "tool-orchestrator": {
        "module": "./tools.ts",
        "title": "Orchestrator tools",
        "description": "The model-facing orchestrator tools. Disable to hide them; the orchestrator service keeps running.",
        "permissions": [
          "conversations",
          "plugins"
        ],
        "contributes": {
          "tools": [
            "capabilities",
            "captain_notes",
            "delegate_task",
            "task_cancel",
            "task_status",
            "thread_create",
            "thread_list",
            "thread_read",
            "thread_send"
          ]
        },
        "requires": [
          "jobs"
        ]
      }
    }
  }
}
