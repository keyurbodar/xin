{
  "name": "xin-plugin-presets",
  "version": "0.1.0",
  "private": true,
  "description": "Named agent presets that choose a conversation's plugins.",
  "type": "module",
  "xin": {
    "plugins": {
      "presets": {
        "module": "./index.ts",
        "title": "Presets",
        "description": "Named agent presets that choose a conversation's plugins."
      },
      "preset": {
        "module": "./preset.ts",
        "title": "Preset",
        "description": "One agent preset carried by a row, for bundles."
      }
    },
    "bundle": [
      {
        "id": "presets",
        "plugin": "presets",
        "config": {
          "default": "full"
        }
      },
      {
        "id": "preset-full",
        "plugin": "preset",
        "config": {
          "id": "full",
          "name": "Full",
          "description": "Every plugin.",
          "plugins": "all"
        }
      },
      {
        "id": "preset-minimal",
        "plugin": "preset",
        "config": {
          "id": "minimal",
          "name": "Minimal",
          "description": "Memory and skills only.",
          "plugins": [
            "tool-memory",
            "tool-skills"
          ]
        }
      }
    ]
  }
}
