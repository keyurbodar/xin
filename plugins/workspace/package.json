{
  "name": "ingle-plugin-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Projects and thread documents.",
  "type": "module",
  "ingle": {
    "plugins": {
      "workspace": {
        "module": "./index.ts",
        "title": "Workspace",
        "description": "Projects and thread documents.",
        "permissions": [
          "conversations"
        ],
        "contributes": {
          "ops": [
            "owner.read",
            "owner.set",
            "project.archive",
            "project.create",
            "project.update",
            "puck.archive",
            "puck.create",
            "puck.list",
            "puck.rename",
            "space.archive",
            "space.create",
            "space.update",
            "thread.rename",
            "workspace.read"
          ]
        }
      }
    }
  }
}
