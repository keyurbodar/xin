{
  "name": "ingle-plugin-models",
  "version": "0.1.0",
  "private": true,
  "description": "Run-time model catalog, credentials and set_model.",
  "type": "module",
  "ingle": {
    "plugins": {
      "models": {
        "module": "./index.ts",
        "title": "Models",
        "description": "Run-time model catalog, credentials and set_model.",
        "permissions": [
          "conversations",
          "network",
          "runtime",
          "storage"
        ],
        "contributes": {
          "ops": [
            "conv.configure",
            "conv.context",
            "credential.delete",
            "credential.set",
            "models.list",
            "owner.defaults",
            "usage.alert",
            "usage.alert.set",
            "usage.cap",
            "usage.cap.set",
            "usage.summary"
          ]
        }
      },
      "tool-models": {
        "module": "./tools.ts",
        "title": "Models tools",
        "description": "The model-facing models tools. Disable to hide them; the models service keeps running.",
        "permissions": [
          "models",
          "network"
        ],
        "contributes": {
          "tools": [
            "set_model"
          ]
        }
      }
    }
  }
}
