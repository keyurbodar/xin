{
  "name": "ingle-plugin-web",
  "version": "0.1.0",
  "private": true,
  "description": "Public web page fetch, and web search once a Brave Search key is set.",
  "type": "module",
  "ingle": {
    "plugins": {
      "tool-web": {
        "module": "./index.ts",
        "title": "Web tools",
        "description": "Fetch a public page as readable text, and search the web once a Brave Search key is set.",
        "permissions": [
          "network",
          "secrets"
        ],
        "credentials": [
          "brave_search"
        ],
        "contributes": {
          "tools": [
            "web_fetch",
            "web_search"
          ]
        },
        "requires": [
          "jobs"
        ]
      }
    },
    "bundle": [
      {
        "id": "tool-web",
        "plugin": "tool-web"
      }
    ]
  }
}
