{
  "name": "ingle-plugin-market",
  "version": "0.1.0",
  "private": true,
  "description": "Find, install and update plugin packages from npm and market indexes.",
  "type": "module",
  "ingle": {
    "plugins": {
      "market": {
        "module": "./index.ts",
        "title": "Market",
        "description": "Discovery, install and update checks for plugin packages.",
        "permissions": [
          "network",
          "plugins",
          "runtime",
          "storage"
        ],
        "contributes": {
          "ops": [
            "market.entry",
            "market.install",
            "market.policy",
            "market.policy.set",
            "market.refresh",
            "market.rollback",
            "market.add",
            "market.search",
            "market.skip",
            "market.skipped",
            "market.unskip",
            "market.update"
          ]
        }
      }
    }
  }
}
