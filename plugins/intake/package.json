{
  "name": "ingle-plugin-intake",
  "version": "0.1.0",
  "private": true,
  "description": "Inbound debounce, batch claim and dispatch.",
  "type": "module",
  "ingle": {
    "plugins": {
      "intake": {
        "module": "./index.ts",
        "title": "Intake",
        "description": "Inbound debounce, batch claim and dispatch.",
        "permissions": [
          "conversations",
          "files",
          "models",
          "runtime"
        ],
        "contributes": {
          "ops": [
            "conv.stop",
            "history.page",
            "message.send",
            "message.withdraw"
          ]
        }
      }
    }
  }
}
