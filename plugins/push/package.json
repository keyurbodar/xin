{
  "name": "ingle-plugin-push",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypted pushes when no tab is open.",
  "type": "module",
  "ingle": {
    "plugins": {
      "push": {
        "module": "./index.ts",
        "title": "Web Push",
        "description": "Encrypted pushes when no tab is open.",
        "permissions": [
          "network",
          "runtime",
          "storage"
        ],
        "contributes": {
          "ops": [
            "notify.prefs",
            "notify.quiet",
            "notify.quiet.set",
            "notify.set",
            "push.key",
            "push.list",
            "push.subscribe",
            "push.test",
            "push.unsubscribe"
          ]
        }
      }
    }
  }
}
