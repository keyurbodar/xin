{
  "name": "ingle-plugin-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Notes with FTS recall and the Dreamer.",
  "type": "module",
  "ingle": {
    "plugins": {
      "memory": {
        "module": "./index.ts",
        "title": "Memory",
        "description": "Notes with FTS recall and the Dreamer.",
        "permissions": [
          "conversations",
          "models",
          "storage"
        ],
        "contributes": {
          "ops": [
            "memory.add",
            "memory.dismiss",
            "memory.edit",
            "memory.forget",
            "memory.list",
            "memory.pin",
            "memory.profile",
            "memory.profile.write",
            "memory.suggested"
          ]
        }
      },
      "tool-memory": {
        "module": "./tools.ts",
        "title": "Memory tools",
        "description": "The model-facing memory tools. Disable to hide them; the memory service keeps running.",
        "contributes": {
          "tools": [
            "recall",
            "remember"
          ]
        }
      }
    }
  }
}
