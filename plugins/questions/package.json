{
  "name": "ingle-plugin-questions",
  "version": "0.1.0",
  "private": true,
  "description": "ask_user and pending requests.",
  "type": "module",
  "ingle": {
    "plugins": {
      "questions": {
        "module": "./index.ts",
        "title": "Questions",
        "description": "ask_user and pending requests.",
        "permissions": [
          "conversations"
        ],
        "contributes": {
          "ops": [
            "request.list",
            "request.respond"
          ]
        }
      },
      "tool-questions": {
        "module": "./tools.ts",
        "title": "Questions tools",
        "description": "The model-facing questions tools. Disable to hide them; the questions service keeps running.",
        "contributes": {
          "tools": [
            "ask_user",
            "pending_request"
          ]
        }
      }
    }
  }
}
