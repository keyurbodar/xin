{
  "name": "ingle-plugin-git",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only git history tools for a project's GitHub repository.",
  "type": "module",
  "ingle": {
    "plugins": {
      "tool-git": {
        "module": "./index.ts",
        "title": "Git tools",
        "description": "Read-only log, diff, show and blame for the project's GitHub repository.",
        "permissions": [
          "network",
          "secrets"
        ],
        "contributes": {
          "tools": [
            "git_blame",
            "git_diff",
            "git_log",
            "git_show"
          ]
        }
      }
    },
    "bundle": [
      {
        "id": "tool-git",
        "plugin": "tool-git",
        "disabled": true
      }
    ]
  }
}
